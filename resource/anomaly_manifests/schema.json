{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel.local/schemas/anomaly-presentation-manifest-v1.json",
  "title": "Hotel anomaly presentation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "source_scene_id",
    "source_path",
    "source_sha256",
    "canvas",
    "states"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source_scene_id": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "pattern": "^res://resource/images/.+"
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/state"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "width",
        "height"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^res://resource/images/anomalies/.+"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "path",
        "sha256",
        "width",
        "height",
        "z_index"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^res://resource/images/anomalies/.+"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "z_index": {
          "type": "integer"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_only": {
          "type": "boolean"
        },
        "full_scene_variant": {
          "$ref": "#/$defs/artifact"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "base_only"
          ],
          "properties": {
            "base_only": {
              "const": true
            }
          }
        },
        {
          "required": [
            "full_scene_variant"
          ]
        },
        {
          "required": [
            "layers"
          ]
        }
      ]
    }
  }
}
